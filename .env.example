# ---------------------------------------------------------------------------
# Feedex environment
#
# Local development needs none of these: with DATABASE_URL unset, Feedex uses
# an embedded PGlite database under .data/ and a fixed development secret.
# Copy this file to .env.local only when you want to override that.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required in production.
# Leave unset locally to use the embedded PGlite database.
# DATABASE_URL="postgresql://user:password@host:5432/feedex?sslmode=require"

# Where the embedded PGlite database stores its files. Local development only.
# PGLITE_DATA_DIR=".data/feedex"

# Secret used to derive API key digests and sign tokens. Required in production.
# Generate with: openssl rand -base64 48
# AUTH_SECRET=""

# Canonical origin. Used for absolute URLs, cookies, and the widget snippet.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OAuth sign-in (optional)
#
# All four values are optional. A provider without BOTH an id and a secret is
# simply absent from the sign-in page, so the instance can run with passwords
# only, with one provider, or with both.
#
# Redirect URIs to register with each provider:
#   http://localhost:3000/api/auth/google/callback
#   https://feedex.rianfernando.com/api/auth/google/callback
#   http://localhost:3000/api/auth/github/callback
#   https://feedex.rianfernando.com/api/auth/github/callback
# ---------------------------------------------------------------------------

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GitHub -> Settings -> Developer settings -> OAuth Apps
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Set to "true" to close registration once your account exists.
# Note: this also blocks first-time sign-up through a provider.
# DISABLE_SIGNUP="false"
