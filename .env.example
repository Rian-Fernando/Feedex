# ---------------------------------------------------------------------------
# Feedex environment
#
# Local development needs none of these: with DATABASE_URL unset, Feedex uses
# an embedded PGlite database under .data/ and a fixed development secret.
# Copy this file to .env.local only when you want to override that.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required in production.
# Leave unset locally to use the embedded PGlite database.
# DATABASE_URL="postgresql://user:password@host:5432/feedex?sslmode=require"

# Where the embedded PGlite database stores its files. Local development only.
# PGLITE_DATA_DIR=".data/feedex"

# Secret used to derive API key digests and sign tokens. Required in production.
# Generate with: openssl rand -base64 48
# AUTH_SECRET=""

# Canonical origin. Used for absolute URLs, cookies, and the widget snippet.
APP_URL="http://localhost:3000"

# Set to "true" to close registration once your account exists.
# DISABLE_SIGNUP="false"
