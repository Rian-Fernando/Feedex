{
  "name": "feedex",
  "version": "0.1.0",
  "private": true,
  "description": "Collect, organize, and resolve feedback from every project in one dashboard.",
  "homepage": "https://feedex.rianfernando.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rian-Fernando/Feedex.git"
  },
  "license": "MIT",
  "author": "Rian Fernando <https://rianfernando.com>",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run widget:build && next dev",
    "build": "npm run widget:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:studio": "drizzle-kit studio",
    "widget:build": "node scripts/build-widget.mjs",
    "widget:watch": "node scripts/build-widget.mjs --watch",
    "og:generate": "tsx scripts/generate-og.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test:e2e": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.28.0",
    "motion": "12.43.0",
    "next": "16.2.12",
    "pg": "8.22.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "playwright-core": "^1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
